{
  "manifest_version": 3,
  "name": "Panel Lateral Apps",
  "version": "1.6",
  "description": "WhatsApp, Instagram y más en un panel lateral fijo, como Opera.",
  "permissions": [
    "sidePanel",
    "storage",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "action": {
    "default_title": "Abrir panel lateral"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "r",
        "enabled": true,
        "path": "rules.json"
      },
      {
        "id": "r2",
        "enabled": true,
        "path": "rules2.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "apps.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "unframe.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ],
  "commands": {
    "close-panel": {
      "suggested_key": {
        "default": "Alt+Shift+W"
      },
      "description": "Cerrar el panel lateral"
    }
  }
}